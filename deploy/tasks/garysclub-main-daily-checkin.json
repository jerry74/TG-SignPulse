  "success_patterns": [
    "今日已打卡",
    "打卡成功",
    "签到成功",
    "已打卡"
  ],
  "failure_patterns": [
    "打卡失败",
    "签到失败",
    "操作失败",
    "验证失败"
  ],
  "enabled": false
